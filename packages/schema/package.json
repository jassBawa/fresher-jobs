{
  "name": "@jobs/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types and JSON Schemas for job facts and draft posts.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fact-record.json": "./src/fact-record.schema.json",
    "./draft-post.json": "./src/draft-post.schema.json"
  },
  "files": ["dist", "src/*.schema.json"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint configured\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
