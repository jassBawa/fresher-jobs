{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobs.dev/schemas/draft-post.json",
  "title": "DraftFrontmatter",
  "description": "YAML frontmatter of a draft post in data/drafts/*.md.",
  "type": "object",
  "required": [
    "title",
    "description",
    "slug",
    "status",
    "company",
    "role",
    "generatedBy",
    "createdAt"
  ],
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "slug": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "published"] },
    "company": { "type": "string" },
    "role": { "type": "string" },
    "jobType": { "type": "string", "enum": ["full-time", "internship", "contract", "trainee"] },
    "batchYears": { "type": "array", "items": { "type": "string" } },
    "locations": { "type": "array", "items": { "type": "string" } },
    "salary": { "type": "string" },
    "lastDateToApply": { "type": "string" },
    "applyByDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Deadline as a calendar day. Absent when the source named no real date."
    },
    "applyUrl": { "type": "string", "format": "uri" },
    "skills": { "type": "array", "items": { "type": "string" } },
    "generatedBy": { "type": "string", "enum": ["llm+template", "template"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "postedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "When the employer announced the opening. Drives the freshness horizon and JSON-LD datePosted."
    },
    "sourceRef": { "type": "string", "format": "uri" }
  },
  "additionalProperties": false
}
