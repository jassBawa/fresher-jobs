# Set ONE of these. Cheapest and fastest first — the pipeline auto-detects.
# This workload is a parser plus short templated copy, so a small fast model is
# the right tool, not a compromise.

# Groq — free tier, ~500 tok/s. Best default.        console.groq.com
GROQ_API_KEY=

# Cerebras — free tier, fastest available.           cloud.cerebras.ai
# CEREBRAS_API_KEY=

# Gemini — free tier, strict JSON mode.              aistudio.google.com
# GEMINI_API_KEY=

# OpenRouter — has genuinely free models.            openrouter.ai
# OPENROUTER_API_KEY=

# Local, no key, no cost, no rate limit:
#   ollama serve && ollama pull qwen3:4b
# LLM_PROVIDER=ollama

# Paid fallbacks
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- optional ----------------------------------------------------------------
# LLM_MODEL=llama-3.1-8b-instant   # override the model for your provider
# MAX_POSTS_PER_RUN=15             # how many new postings to process per run
# SITE_NAME=Your Jobs Site         # used in the drafting prompt
# SOURCE_BASE=https://freshersdunia.in
