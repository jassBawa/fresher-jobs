{
  "name": "@jobs/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fetch job postings, extract facts, draft original posts. Zero npm dependencies.",
  "scripts": {
    "ingest": "node --env-file-if-exists=.env src/fetch.mjs && node --env-file-if-exists=.env src/draft.mjs",
    "fetch": "node --env-file-if-exists=.env src/fetch.mjs",
    "draft": "node --env-file-if-exists=.env src/draft.mjs",
    "fetch:dry": "node --env-file-if-exists=.env src/fetch.mjs --dry",
    "draft:nollm": "node src/draft.mjs --no-llm",
    "promote": "node scripts/promote.mjs",
    "typecheck": "echo \"no types — .mjs scripts\"",
    "lint": "echo \"no lint configured\"",
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  }
}
