---
/**
 * Listings as receipt lines.
 *
 * Every row answers the eligibility question in the order the reader asks it:
 * is it still open, who is hiring, for what, and am I allowed to apply. The
 * key-value rail is set at the one type size the whole listing surface shares —
 * labels differ from values by case, weight and colour, never by scale.
 *
 * An ad slot is interleaved after the first few rows on long lists, never
 * before them.
 */
import type { DraftFrontmatter } from '@jobs/schema';
import StatusMark from './StatusMark.astro';
import AdSlot from './AdSlot.astro';
import { statusOf, closesLabel, shortDay, payLabel, today } from '../lib/listings';

interface Props {
	listings: DraftFrontmatter[];
	empty?: string;
	/** Interleave a reserved ad slot after this many rows. 0 disables. */
	adAfter?: number;
	/** Render in the lower register used for listings that have closed. */
	closed?: boolean;
}

const {
	listings,
	empty = 'Nothing open here right now.',
	adAfter = 0,
	closed = false,
} = Astro.props;
const on = today();

const cap = (arr: string[] | undefined, n: number): string => {
	if (!arr?.length) return '';
	return arr.length > n ? `${arr.slice(0, n).join(', ')} +${arr.length - n}` : arr.join(', ');
};
---

{
	listings.length === 0 ? (
		<p class="empty">{empty}</p>
	) : (
		<ul class="rows">
			{listings.map((fm, i) => {
				const status = statusOf(fm, on);
				return (
					<>
						<li class:list={['row', closed && 'row--closed']}>
							<div class="row__rail">
								<StatusMark status={status} />
								<span class="row__posted">{shortDay(fm.postedAt ?? fm.createdAt.slice(0, 10))}</span>
							</div>

							<a class="row__role" href={`/jobs/${fm.slug}/`}>
								<span class="row__company">{fm.company}</span> — {fm.role}
							</a>

							<dl class="facts">
								{fm.batchYears?.length && (
									<>
										<dt>Batch</dt>
										<dd>{fm.batchYears.join(', ')}</dd>
									</>
								)}
								{fm.locations?.length && (
									<>
										<dt>Where</dt>
										<dd>{cap(fm.locations, 3)}</dd>
									</>
								)}
								{fm.salary && (
									<>
										<dt>Pay</dt>
										<dd>
											{payLabel(fm.salary)} <em>· estimated</em>
										</dd>
									</>
								)}
								<dt>Closes</dt>
								<dd>{closesLabel(fm, on)}</dd>
							</dl>
						</li>
						{adAfter > 0 && i === adAfter - 1 && listings.length > adAfter + 1 && (
							<li class="row row--ad">
								<AdSlot placement="feed" />
							</li>
						)}
					</>
				);
			})}
		</ul>
	)
}

<style>
	.empty {
		padding-block: var(--space-6);
		color: var(--ink-2);
	}

	.row--ad {
		border-bottom: 0;
		padding-block: 0;
	}
</style>
