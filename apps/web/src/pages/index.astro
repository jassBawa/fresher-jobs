---
import Base from '../layouts/Base.astro';
import JobList from '../components/JobList.astro';
import AdSlot from '../components/AdSlot.astro';
import { buildClusters, type Cluster, type ClusterKind } from '../lib/clusters';
import { liveListings } from '../lib/site';
import { statusOf, today, shortDay } from '../lib/listings';

const on = today();
const jobs = await liveListings(on);
const listings = jobs.map((job) => job.data);
const clusters = buildClusters(listings);

const closingSoon = listings.filter((fm) => statusOf(fm, on) === 'closing').length;

const GROUPS: ReadonlyArray<{ kind: ClusterKind; label: string }> = [
	{ kind: 'role', label: 'By role' },
	{ kind: 'city', label: 'By city' },
	{ kind: 'batch', label: 'By batch' },
	{ kind: 'company', label: 'By company' },
];

const group = (kind: ClusterKind): Cluster[] => clusters.filter((c) => c.kind === kind);
---

<Base title="Fresher Jobs in India — Off Campus Drives, Batch-wise | PehlaJob">
	<section class="field">
		<div class="wrap field__inner">
			<h1 class="display">
				{listings.length} openings you can still apply for
			</h1>
			<p class="field__meta">
				<span>Checked {shortDay(on)}</span>
				{closingSoon > 0 && <span>{closingSoon} closing this week</span>}
				<span>Every listing links to the company's own form</span>
			</p>
		</div>
	</section>

	<div class="wrap">
		<JobList listings={listings} empty="No openings published yet. Check back soon." adAfter={4} />

		{
			clusters.length > 0 && (
				<nav class="browse rule-top" aria-label="Browse openings">
					<h2 class="label browse__title">Browse</h2>
					{GROUPS.map(({ kind, label }) =>
						group(kind).length ? (
							<div class="facet">
								<h3 class="facet__head">{label}</h3>
								<ul class="facet__list">
									{group(kind).map((c) => (
										<li>
											<a href={`/${c.path}/`}>{c.heading}</a>{' '}
											<span class="facet__count">{c.slugs.length}</span>
										</li>
									))}
								</ul>
							</div>
						) : null
					)}
				</nav>
			)
		}

		<AdSlot placement="foot" />
	</div>
</Base>

<style>
	.browse {
		margin-top: var(--space-6);
		padding-top: var(--space-5);
	}

	.browse__title {
		margin-bottom: var(--space-4);
	}

	.facet__head {
		font-size: var(--fs);
		font-weight: 700;
	}
</style>
