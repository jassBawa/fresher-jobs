---
/**
 * Every cluster page, from one route — the indexable surface (D5, D15).
 *
 * Route priority puts the static pages and /jobs/[slug] ahead of this rest
 * parameter, and getStaticPaths only emits cluster paths, so nothing here
 * shadows an existing route.
 */
import Base from '../layouts/Base.astro';
import JobList from '../components/JobList.astro';
import AdSlot from '../components/AdSlot.astro';
import { buildClusters, clusterRobots, clusterIsIndexable } from '../lib/clusters';
import { liveListings } from '../lib/site';
import { statusOf, today, shortDay } from '../lib/listings';

export const getStaticPaths = async () => {
	const jobs = await liveListings();
	const bySlug = new Map(jobs.map((job) => [job.data.slug, job.data]));

	return buildClusters(jobs.map((job) => job.data)).map((cluster) => ({
		params: { cluster: cluster.path },
		props: {
			cluster,
			listings: cluster.slugs.map((slug) => bySlug.get(slug)).filter((fm) => fm !== undefined),
		},
	}));
};

const { cluster, listings } = Astro.props;
const on = today();
const closingSoon = listings.filter((fm) => statusOf(fm, on) === 'closing').length;
const thin = !clusterIsIndexable(cluster);
---

<Base title={cluster.title} description={cluster.description} robots={clusterRobots(cluster)}>
	<section class="field">
		<div class="wrap field__inner">
			<h1 class="display">{cluster.heading}</h1>
			<p class="field__meta">
				<span>{listings.length} open now</span>
				{closingSoon > 0 && <span>{closingSoon} closing this week</span>}
				<span>Checked {shortDay(on)}</span>
			</p>
		</div>
	</section>

	<div class="wrap">
		<JobList listings={listings} adAfter={4} />

		<p class="back rule-top">
			<a href="/">← All openings</a>
			{thin && <span class="fine"> · too few here to list in search yet</span>}
		</p>

		<AdSlot placement="foot" />
	</div>
</Base>

<style>
	.back {
		margin-top: var(--space-6);
		padding-top: var(--space-4);
	}

	.back a {
		text-decoration: none;
		font-weight: 600;
	}

	.back a:hover {
		text-decoration: underline;
	}
</style>
