---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isExpired, listingRobots, expiresOn, today } from '../../lib/listings';

export const getStaticPaths = async () => {
	const jobs = await getCollection('jobs', ({ data }) => data.status === 'published');
	return jobs.map((job) => ({
		params: { slug: job.data.slug },
		props: { job },
	}));
};

const { job } = Astro.props;
const { Content } = await render(job);
const fm = job.data;

// Expired listings keep their page — inbound links and bookmarks should not
// 404 — but they drop out of every index surface and say so at the top.
const on = today();
const expired = isExpired(fm, on);
const closedOn = expiresOn(fm);
---

<Base title={fm.title} description={fm.description} robots={listingRobots(fm, on)}>
	<article>
		{
			expired && (
				<p class="closed">
					<strong>Applications closed.</strong> This opening is no longer accepting
					applications{closedOn ? ` as of ${closedOn}` : ''}. It is kept here for reference —
					see <a href="/">current openings</a>.
				</p>
			)
		}

		<h1>{fm.title}</h1>
		<p>
			<strong>{fm.company}</strong> · {fm.role}
			{fm.locations?.length ? ` · ${fm.locations.join(', ')}` : ''}
		</p>
		{fm.salary && <p>
			<strong>Salary:</strong> {fm.salary}
		</p>}
		{fm.lastDateToApply && <p>
			<strong>Last date:</strong> {fm.lastDateToApply}
		</p>}
		{fm.applyUrl && !expired && (
			<p>
				<a href={fm.applyUrl} rel="nofollow sponsored">
					Apply now
				</a>
			</p>
		)}

		<Content />
	</article>
</Base>

<style>
	.closed {
		border: 1px solid #e7e5e4;
		border-left: 3px solid #a8a29e;
		background: #fafaf9;
		padding: 0.75rem 1rem;
		border-radius: 4px;
		font-size: 0.95rem;
	}
</style>
