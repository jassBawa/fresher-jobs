{
  "name": "jobs-platform",
  "version": "0.1.0",
  "private": true,
  "description": "India jobs content platform — ingest pipeline, shared schema, web app (monorepo).",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "turbo run build typecheck test",
    "test": "turbo run test",
    "ingest": "pnpm --filter @jobs/ingest run ingest",
    "fetch": "pnpm --filter @jobs/ingest run fetch",
    "draft": "pnpm --filter @jobs/ingest run draft",
    "fetch:dry": "pnpm --filter @jobs/ingest run fetch:dry",
    "draft:nollm": "pnpm --filter @jobs/ingest run draft:nollm",
    "promote": "pnpm --filter @jobs/ingest run promote",
    "drafts": "pnpm --filter @jobs/ingest run promote --list",
    "db:up": "docker compose up -d && docker compose ps",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @jobs/db run db:migrate",
    "db:import": "pnpm --filter @jobs/db run import",
    "verify:apply": "pnpm --filter @jobs/db run verify:apply",
    "daily": "./scripts/daily.sh",
    "dev": "pnpm --filter @jobs/site run dev",
    "start": "pnpm --filter @jobs/site run start"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
